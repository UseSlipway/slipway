NODE_ENV=development
PORT=3001
DATABASE_URL=
RHC_RPC_URL=
BASE_RPC_URL=
SPCX_RPC_URL=https://rpc.spcxchain.network
CODEX_API_KEY=
SERVER_API_KEY=
SECURITY_ALERT_WEBHOOK_URL=
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional data provider; leave empty unless a specific feature needs it.
X402_ENABLED=true
X402_FACILITATOR_API_KEY=
X402_FACILITATOR_PRIVATE_KEY=
X402_RHC_CHAIN_ID=4663
X402_BASE_CHAIN_ID=8453
X402_RHC_USDG_ADDRESS=
X402_BASE_USDC_ADDRESS=
X402_RHC_PAY_TO=
X402_BASE_PAY_TO=
SLIPWAY_RHC_RESTRICTED_FEE_ROUTER_ADDRESS=
SLIPWAY_BASE_RESTRICTED_FEE_ROUTER_ADDRESS=

# Trading is active with restricted fee routers deployed on both supported chains.
# Set to false to pause trading.
SLIPWAY_TRADING_ENABLED=true
SLIPWAY_AUTH_DOMAIN=tryslipway.com
SLIPWAY_AUTH_URI=https://tryslipway.com

# Optional market data key. Without it, GeckoTerminal's public API is used, which limits by IP
# (shared with other apps on the same host). Get a key at https://www.coingecko.com/en/api.
# COINGECKO_API_PLAN is "demo" (free key) or "pro" (paid plans).
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo
# Upstream market calls per minute (default 24, or 200 on the pro plan).
MARKET_UPSTREAM_PER_MINUTE=

# Optional RPC for the Pons history backfill. Needs large eth_getLogs ranges; defaults to
# Robinhood Chain's public RPC. Live indexing keeps using RHC_RPC_URL.
BACKFILL_RPC_URL_RHC=
