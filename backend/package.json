{
  "name": "@slipway/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun -e \"import('./src/db/migrate.ts').then(({ migrate }) => migrate())\""
  },
  "dependencies": {
    "@x402/core": "2.32.0",
    "@x402/evm": "2.32.0",
    "clanker-sdk": "4.2.18",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "viem": "2.58.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.5",
  "overrides": {
    "uuid": "11.1.1"
  }
}
