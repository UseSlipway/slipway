{
  "name": "@slipway/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun -e \"import('./src/db/migrate.ts').then(({ migrate }) => migrate())\""
  },
  "dependencies": {
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "clanker-sdk": "4.2.18",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
